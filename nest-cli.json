{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "main",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "tsConfigPath": "tsconfig.build.json",
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "classValidatorShim": true,
          "dtoFileNameSuffix": [".dto", ".entity"],
          "controllerFileNameSuffix": [".controller"],
          "introspectComments": true
        }
      }
    ]
  },
  "generateOptions": {
    "spec": true,
    "flat": false
  }
}